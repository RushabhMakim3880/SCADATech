#--------------------------------------------------------------------
# Git AutoPush Configuration
#--------------------------------------------------------------------
#@type=generate;label=Git Auto Push Secret;length=32
gitAutoPush.secret = {{gitAutoPush.secret}}
#make sure to match/use above secret in git webhook for autoPush.php to work

#--------------------------------------------------------------------
# Additional Environment Configuration
#--------------------------------------------------------------------
#need to change this only if using cyberpanel, else "php" would be sufficient,used in autopush and cron jobs
#@type=input;label=PHP Environment Path;validate=none;comment=Use `/usr/local/lsws/lsphp81/bin/php` based on your php version in cyberpanel, otherwise use `php` only for non cyberpanel.
phpPath = {{phpPath}}

#for module's route, use like this: \Modules\Frontend\Samples\Controllers\Samples::manageSampleNew
#for controllers in App directory, use like this: Home::index
app.homeRoute = Home::index
app.saasHomeRoute = Home::index

devModePassword = "Mtpl@123"  # Password to access dev mode, presee control+shift+alter+` on login screen and enter this secret to access dev mode, works with only tenant admin or saas admin role.

#type 'yes' to disable use of spark reset command.
#@type=select;label=Disable spark reset command?;options=yes|no;validate=number;comment=type 'yes' to disable use of spark reset command.
disableReset = {{disableReset}}  

#Use port number that is available and need to use for websocket server as listening port.
#@type=input;label=Websocket Port;validate=number;comment=Use port number that is available and need to use for websocket server as listening port.
websocketPort = {{websocketPort}}

#Used for nodejs (backend app) to communicate with CI4 backend.
#@type=generate;label=Internal Api Token;length=32
internalApiToken = {{internalApiToken}}

#--------------------------------------------------------------------
# Web Push Notification
#--------------------------------------------------------------------
#@type=generate;label=Webpush Public Key;keyType=webPushPublicKey
webPushPublicKey = {{webPushPublicKey}}
#@type=generate;label=Webpush Private Key;keyType=webPushPrivateKey
webPushPrivateKey = {{webPushPrivateKey}}
#@type=input;label=Webpush Sender Email;validate=email;comment=This email is used to send web push notifications, make sure to use a valid email address.
webPushSenderEmail = {{webPushSenderEmail}}

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
#@type=select;label=CI4 Environment;options=production|development
CI_ENVIRONMENT = {{environment}}

#Feature flag for production alignment behavior.
#true  = legacy behavior, allow operator to continue even if requested quantity exceeds pending jobcards.
#false = strict behavior, block program alignment when aligned quantity exceeds pending quantity.
#@type=select;label=Strict Program Align Enabled?;options=true|false;comment=true keeps backward compatibility, false enforces pending-quantity validation during alignment.
isStrictProgramAlignEnabled = {{isStrictProgramAlignEnabled}}

#used for caching frontend part for project for performance.
#@type=select;label=Cache Enabled;options=true|false;comment=used for caching frontend part for project for performance.
app.cacheEnabled = {{cacheEnabled}}
#@type=input;label=Cache TTL (Seconds);validate=number
app.cacheTTL = {{cacheTTL}}
#@type=input;label=Base URL;validate=url;comment=Make sure to include trailing slash at the end, e.g., https://example.com/
app.baseURL = {{baseURL}}

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
#@type=input;label=Database Host;validate=none
database.default.hostname = {{hostname}}
#@type=input;label=Database Name;validate=none
database.default.database = {{database}}
#@type=input;label=Database User;validate=none
database.default.username = {{dbUser}}
#@type=input;label=Database Password;validate=none
database.default.password = {{dbPass}}
database.default.DBDriver = MySQLi
database.default.charset  = 'utf8mb4'
database.default.DBCollat = 'utf8mb4_general_ci'

#--------------------------------------------------------------------
# JWT Configuration
#--------------------------------------------------------------------
#@type=generate;label=JWT Secret;length=64
jwt.secretKey = {{secretKey}}
jwt.algorithm = "HS256"
jwt.expireTime = 3600  # Short Login Token validity in seconds (e.g., 1 hour) 3600
jwt.refreshExpireTime = 604800 # Without Rember Me used, Token validity in seconds (e.g., 1 week) 604800
jwt.longExpireTime = 2592000 # When Remember Me is Used , Token validity in seconds (e.g., 30 days) 2592000


#--------------------------------------------------------------------
# Encryption Key
#--------------------------------------------------------------------
#@type=generate;label=Encryption Key;length=64
encryptionKey = {{encryptionKey}}